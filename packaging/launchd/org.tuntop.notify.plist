<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- tuntop desktop notifications (per user). Installed to
     ~/Library/LaunchAgents by scripts/install-macos.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.tuntop.notify</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/tuntop</string>
		<string>notify</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
